# Browser-safe values belong in backend_config.local.js, not here.
# Server-only values below must be supplied through local env files or Supabase Edge Function secrets.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=LOCAL_ONLY_FROM_SUPABASE_STATUS
IDENTIFIER_HMAC_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TOKEN_SECRET=GENERATE_A_DIFFERENT_32_CHARACTER_SECRET
IDENTIFIER_STORAGE_MODE=hmac_only
EXPERIMENT_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
PROLIFIC_COMPLETION_URL=EVIDENCE_REQUIRED
ALLOW_UNAPPROVED_CONSENT_FOR_SYNTHETIC=true
